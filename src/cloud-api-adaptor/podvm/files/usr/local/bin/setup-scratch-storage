#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace

[ -n "${DEBUG:-}" ] && set -o xtrace

handle_error() {
    local exit_code="${?}"
    local line_number="${1:-}"
    echo "error:"
    echo "Failed at $line_number: ${BASH_COMMAND}"
    exit "${exit_code}"
}
trap 'handle_error $LINENO' ERR

die() {
    local msg="$*"
    echo >&2 "ERROR: $msg"
    exit 1
}

# Wait for udev to settle, even if a device node is present
# a device may not be fully initialized yet
if ! udevadm settle --timeout=5; then
	echo "udev has not settled yet. Exiting."
	exit 1
fi

# Check if the trusted_store device exists
DISK_LABEL="trusted_store"
DEV_PATH="/dev/disk/by-label/$DISK_LABEL"

if [ ! -L "$DEV_PATH" ]; then
    echo "Device for label $DISK_LABEL not found. Exiting."
    exit 1
fi

# Resolve the device path
DEV_PATH=$(readlink -f "$DEV_PATH")
if [ ! -b "$DEV_PATH" ]; then
    echo "Device $DEV_PATH is not a block device. Exiting."
    exit 1
fi

# Create mount point
MOUNT_POINT="/run/kata-containers/image"
mkdir -p "$MOUNT_POINT"

# Get device number for the encryption script
# Using xargs to strip leading/trailing whitespace
# DEV_NUM=$(lsblk -no MAJ:MIN "$DEV_PATH" | xargs)

STORAGE_KEY_PATH="/run/encrypt_storage.key"
# Generate encryption key and use LUKS encryption
echo "Setting up LUKS encrypted scratch storage"
touch "$STORAGE_KEY_PATH"
chmod 600 "$STORAGE_KEY_PATH"
head -c 4096 /dev/urandom > "$STORAGE_KEY_PATH"

cryptsetup \
	--batch-mode luksFormat \
	--type luks2 \
	"$DEV_PATH" \
	--sector-size 4096 \
	--cipher aes-xts-plain64 \
	--integrity hmac-sha256 \
	"$STORAGE_KEY_PATH"

LUKS_NAME="scratch_storage"
cryptsetup open --type luks2 -d "$STORAGE_KEY_PATH" "$DEV_PATH" "$LUKS_NAME"

# Remove the key file after use
rm "$STORAGE_KEY_PATH"

LUKS_PATH="/dev/mapper/$LUKS_NAME"
mkfs.ext4 "$LUKS_PATH" -E lazy_journal_init

mount "$LUKS_PATH" "$MOUNT_POINT"

echo "Scratch storage setup completed"
