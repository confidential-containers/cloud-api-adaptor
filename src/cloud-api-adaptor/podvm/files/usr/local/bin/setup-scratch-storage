#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace

[ -n "${DEBUG:-}" ] && set -o xtrace

handle_error() {
    local exit_code="${?}"
    local line_number="${1:-}"
    echo "error:"
    echo "Failed at $line_number: ${BASH_COMMAND}"
    exit "${exit_code}"
}
trap 'handle_error $LINENO' ERR

die() {
    local msg="$*"
    echo >&2 "ERROR: $msg"
    exit 1
}

# Wait for udev to settle, even if a device node is present
# a device may not be fully initialized yet
if ! udevadm settle --timeout=5; then
	echo "udev has not settled yet. Exiting."
	exit 1
fi

# Check if the trusted_store device exists
DISK_LABEL="trusted_store"
DEV_PATH="/dev/disk/by-label/$DISK_LABEL"
MAPPER_NAME="scratch_storage"
MAPPER_PATH="/dev/mapper/${MAPPER_NAME}"
MOUNT_POINT="/run/kata-containers/image"

if [ ! -L "$DEV_PATH" ]; then
    echo "Device for label $DISK_LABEL not found. Exiting."
    exit 1
fi

# Resolve the device path
resolved_dev_path=$(readlink -f "$DEV_PATH")
if [ ! -b "$resolved_dev_path" ]; then
    echo "Device $resolved_dev_path is not a block device. Exiting."
    exit 1
fi

cryptsetup open "$resolved_dev_path" "$MAPPER_NAME" \
	--type plain \
	--key-file /dev/urandom \
	--cipher aes-xts-plain64 \
	--integrity hmac-sha256 \
	--integrity-no-wipe \
	--integrity-no-journal \
	--allow-discards

mkfs.ext4 \
	-E lazy_itable_init=1,lazy_journal_init=1,discard \
	-O ^has_journal \
	"$MAPPER_PATH"

mkdir -p "$MOUNT_POINT"
mount -o discard,relatime "$MAPPER_PATH" "$MOUNT_POINT"

echo "Scratch storage setup completed"
