# No cloud credentials required for byom
# SSH keys and host keys are configured here when secrets.mode: "create".
# For secrets.mode: "reference", create the secrets externally and set
# existingSshKeySecretName / existingByomHostKeySecretName in values.yaml.

# providerSecrets:
#   byom:
#     # SSH keys for CAA to connect to pre-created VMs (required).
#     # Both private and public key must be provided.
#     id_rsa: |
#       -----BEGIN OPENSSH PRIVATE KEY-----
#       ...
#       -----END OPENSSH PRIVATE KEY-----
#     id_rsa_pub: |
#       ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC... user@host
#
#     # SSH host public keys for allowlist mode.
#     # The chart mounts these and sets SSH_HOST_KEY_ALLOWLIST_DIR automatically.
#     hostKeys:
#       vm1_ecdsa.pub: |
#         ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNT...
#       vm1_ed25519.pub: |
#         ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA...
#       vm2_ecdsa.pub: |
#         ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNT...
